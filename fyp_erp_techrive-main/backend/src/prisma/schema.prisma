  status                    Int?
  assesment_type_id         Int?
  sorting_order             Int?
  created_at                DateTime? @db.Timestamp(6)
  updated_at                DateTime? @db.Timestamp(6)
  created_by                Int?
  last_updated_by           Int?

  @@map("assessments")
}

model Assets {
  id                   Int      @id @default(autoincrement())
  product_id           Int
  asset_id             Int
  products_date        DateTime @db.Date
  asset_type           String   @db.VarChar(255)
