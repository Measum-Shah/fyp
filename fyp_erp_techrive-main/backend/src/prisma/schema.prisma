  branch        ErpBranches @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_branch_departments_branch")
  department    Departments @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_branch_departments_department")

  @@index([branch_id], map: "idx_branch_departments_branch_id")
  @@index([department_id], map: "idx_branch_departments_department_id")
