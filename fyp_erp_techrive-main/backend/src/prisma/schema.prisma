generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model AcademicsGroups {
  id         Int       @id @default(autoincrement())
  program_id Int
  name       String    @db.VarChar(191)
  deleted_at DateTime? @db.Timestamp(6)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  @@map("academics_groups")
}

model AcademicsGroupCourses {
  id                 Int       @id @default(autoincrement())
  academics_group_id Int
  course_id          Int
  deleted_at         DateTime? @db.Timestamp(6)
  created_at         DateTime? @db.Timestamp(6)
  updated_at         DateTime? @db.Timestamp(6)

  @@map("academics_group_courses")
}

model AcademicInfos {
  id              Int       @id @default(autoincrement())
  created_at      DateTime? @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)
  created_by      Int
  last_updated_by Int?
  students_id     Int
  institution     String    @db.VarChar(100)
  board           String?   @db.VarChar(50)
  pass_year       String    @db.VarChar(4)
  symbol_no       String?   @db.VarChar(15)
  percentage      Int
  division_grade  String    @db.VarChar(10)
  major_subjects  String?   @db.VarChar(50)
  remark          String?
  sorting_order   Int?
  status          Int       @default(1) @db.SmallInt
  total_marks     Int?
  obtained_marks  Int?
  qualification   String?   @db.VarChar(191)
  subjects_read   String?   @db.VarChar(191)

  @@map("academic_infos")
}

model AccumulativeReport {
  id                        Int       @id @default(autoincrement())
  student_id                Int?
  board_id                  Int?
  program_id                Int?
  class_id                  Int?
  active_session_id         Int?
  session_id                Int?
  active_session_section_id Int?
  status                    Int?      @default(1) @db.SmallInt
  grading_types_id          Int?
  created_at                DateTime? @db.Timestamp(6)
  updated_at                DateTime? @db.Timestamp(6)

  @@map("accumulative_report")
}

model AccumulativeReportDetails {
  id                     Int       @id @default(autoincrement())
  accumulative_report_id Int?
  subject_id             Int?
  term1_marks            Int?
  term1_total            Int?
  term2_marks            Int?
  term2_total            Int?
  term1_percentage       Int?
  term2_percentage       Int?
  grade                  String?   @db.VarChar(191)
  published              Int?      @default(0) @db.SmallInt
  created_at             DateTime? @db.Timestamp(6)
  updated_at             DateTime? @db.Timestamp(6)

  @@map("accumulative_report_details")
}

model ActiveSessions {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(191)
  session_id Int
  board_id   Int
  branch_id  Int
  program_id Int
  class_id   Int
  intake_id  Int?
  status     String    @default("Active")
  deleted_at DateTime? @db.Timestamp(6)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  @@map("active_sessions")
}

model ActiveSessionSections {
  id                Int       @id @default(autoincrement())
  active_session_id Int
  section_id        Int
  created_at        DateTime? @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)

  @@map("active_session_sections")
}

model ActiveSessionStudents {
  id                        Int       @id @default(autoincrement())
  active_session_section_id Int?
  student_id                Int
  academics_group_id        Int?
  tuition_fee               Int?      @default(0)
  status                    Int?
  created_at                DateTime? @db.Timestamp(6)
  updated_at                DateTime? @db.Timestamp(6)
  deleted_at                DateTime? @db.Timestamp(6)

  @@map("active_session_students")
}

model ActiveSessionTeachers {
  id                        Int       @id @default(autoincrement())
  active_session_section_id Int
  staff_id                  Int
  rate_per_lecture          Int?
  course_ids                String?   @db.VarChar(191)
  rates                     String    @default("0") @db.VarChar(191)
  days_in_month             String    @default("0") @db.VarChar(191)
  class_timetable_id        Int
  created_at                DateTime? @db.Timestamp(6)
  updated_at                DateTime? @db.Timestamp(6)
  status                    Int       @default(1)
  start_date                DateTime? @db.Date
  end_date                  DateTime? @db.Date

  @@map("active_session_teachers")
}

model Addressinfos {
  id              Int       @id @default(autoincrement())
  created_by      Int?
  last_updated_by Int?
  students_id     Int
  address         String?
  state           String?
  city            String?
  temp_city       String?   @db.VarChar(191)
  country         String?
  temp_address    String?
  temp_state      String?
  temp_country    String?
  home_phone      String?
  mobile_1        String?
  mobile_2        String?
  status          Int       @db.SmallInt
  created_at      DateTime? @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)
  deleted_at      DateTime? @db.Timestamp(6)

  @@map("addressinfos")
}

model AddGoodsBranch {
  id            Int       @id @default(autoincrement())
  branch_id     Int
  product_id    Int
  p_image       Bytes?
  department_id Int?
  qty           Int
  description   String?   @db.VarChar(191)
  created_at    DateTime? @db.Timestamp(6)
  updated_at    DateTime? @db.Timestamp(6)

  @@map("add_goods_branch")
}

model Agendas {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(191)
  subject     String    @db.VarChar(191)
  reason      String?   @default("No Reason") @db.VarChar(191)
  description String    @db.VarChar(191)
  status      String    @default("pending") @db.VarChar(191)
  created_by  Int?
  created_at  DateTime? @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  branch_id   Int

  @@map("agendas")
}

model AlertSettings {
  id              Int       @id @default(autoincrement())
  created_at      DateTime? @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)
  created_by      Int
  last_updated_by Int?
  event           String    @db.VarChar(100)
  sms             Int       @default(1) @db.SmallInt
  email           Int       @default(1) @db.SmallInt
  subject         String    @db.VarChar(100)
  template        String
  status          Int       @default(1) @db.SmallInt

  @@map("alert_settings")
}

model AnnualCalendars {
  id         Int       @id @default(autoincrement())
  branch_id  Int?
  title      String    @db.VarChar(250)
  start      DateTime? @db.Timestamp(6)
  end        DateTime? @db.Timestamp(6)
  type       String?   @default("National Holiday")
  color      String?   @default("green") @db.VarChar(100)
  created_by Int?
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  @@map("annual_calendars")
}

model ApiAuthenticationUser {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(191)
  bank_id    Int?
  password   String    @db.VarChar(191)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  @@map("api_authentication_user")
}

model ApiPaymentTransaction {
  id                 Int      @id @default(autoincrement())
  transaction_number String
  bill_no            String   @db.VarChar(255)
  amount             String   @db.VarChar(255)
  paid_date          DateTime @db.Date
  account_no         String
  email              String   @db.VarChar(255)
  created_at         DateTime @db.Timestamp(6)
  updated_at         DateTime @db.Timestamp(6)

  @@map("api_payment_transaction")
}

model ApproveAgendas {
  id                Int       @id @default(autoincrement())
  date              DateTime  @db.Date
  time              DateTime  @db.Time(6)
  location          String    @db.VarChar(191)
  description       String    @db.VarChar(191)
  in_campus         Int
  agenda_request_id Int
  created_at        DateTime? @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)

  @@map("approve_agendas")
}

model AssesmentTypes {
  id         Int       @id @default(autoincrement())
  name       String?   @db.VarChar(191)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  @@map("assesment_types")
}

model Assessments {
  id                        Int       @id @default(autoincrement())
  active_session_id         Int?
  active_session_teacher_id Int?
  active_session_section_id Int?
  session_id                Int?
  branch_id                 Int?
  board_id                  Int?
  program_id                Int?
