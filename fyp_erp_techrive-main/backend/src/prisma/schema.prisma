  id          Int      @id @default(autoincrement())
  user_name   String   @db.VarChar(191)
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   String   @db.VarChar(100)
  details     String?  @db.Text
  created_at  DateTime @default(now())

  @@map("accounts_audit_trail")
}

model AccVoucherTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(191)
  voucher_type String   @db.VarChar(10)
  narration    String?  @db.Text
  lines        Json
  created_by   String?  @db.VarChar(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("accounts_voucher_templates")
}

model GLMappingConfig {
  id                     Int      @id @default(autoincrement())
  event_key              String   @unique @db.VarChar(50)
  default_debit_ledger_id  Int?
  default_credit_ledger_id Int?
  auto_post              Boolean  @default(false)
  description            String?  @db.Text
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("acc_gl_mapping_config")
}

