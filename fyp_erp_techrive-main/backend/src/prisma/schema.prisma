  category        Int?
  branch_id       Int?
  session_id      Int?
  board_id        Int
  program_id      Int
  class_id        Int
  section_id      Int
  intake_id       Int
  publish_date    DateTime? @db.Date
  end_date        DateTime? @db.Date
  total_marks     Int?
  title           String?   @db.VarChar(100)
